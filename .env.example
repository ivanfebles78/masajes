# Copia este archivo como .env para desarrollo local.
PORT=4330
NODE_ENV=development

# PostgreSQL. Sin esta variable, en local se usa un Postgres embebido en memoria.
# DATABASE_URL=postgres://usuario:clave@host:5432/basededatos
# PGSSL=true

# Número de proxies delante de la app (1 en Railway). Afecta al límite por IP.
# TRUST_PROXY=1

# Cadena aleatoria de al menos 32 caracteres (obligatoria en producción).
# SESSION_SECRET=

# Correo de confirmación (Resend). Sin estas dos, el correo queda en modo simulado.
# RESEND_API_KEY=
# MAIL_FROM=PausatZen <citas@tudominio.es>

# Contraseña inicial del usuario «admin». Solo se usa para crearlo la primera
# vez y se guarda hasheada (bcrypt). Obligatoria en producción.
# ADMIN_PASSWORD=

# Pago online con Stripe (tienda de sesiones y bonos). Sin la clave secreta el
# pago online queda desactivado. Usa claves sk_test_… para probar.
# STRIPE_SECRET_KEY=
# Secreto del webhook (whsec_…) del endpoint https://TU-DOMINIO/api/stripe/webhook
# con los eventos checkout.session.completed, checkout.session.async_payment_succeeded
# y checkout.session.expired.
# STRIPE_WEBHOOK_SECRET=
# Dirección pública de la web (en Railway se deduce sola de RAILWAY_PUBLIC_DOMAIN).
# PUBLIC_URL=https://tudominio.es
